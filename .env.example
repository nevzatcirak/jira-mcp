# Required: base URL of your Jira instance (trailing slashes are normalized automatically)
JIRA_BASE_URL=https://jira.example.com

# Required: JIRA_API_TOKEN
# - Jira Server / Data Center: Personal Access Token (sent as "Authorization: Bearer <token>")
# - Jira Cloud: API token from https://id.atlassian.com/manage-profile/security/api-tokens
#   (sent as "Authorization: Basic base64(JIRA_EMAIL:token)")
JIRA_API_TOKEN=

# Required ONLY for Jira Cloud (used together with the API token for Basic auth)
JIRA_EMAIL=

# Optional: "auto" (default) | "server" | "cloud"
# "auto" detects the deployment type from GET /rest/api/2/serverInfo on the first tool call.
JIRA_INSTANCE_TYPE=auto

# Optional: path to a JSONC file defining custom provider endpoints for
# jira_provider_call (workplace-specific Jira plugin REST endpoints).
# See examples/providers.example.jsonc for the schema.
JIRA_PROVIDERS_CONFIG=
